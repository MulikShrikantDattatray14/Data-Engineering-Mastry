  "steps": [
    {
      "id": "stage1",
      "title": "Check the displayed value and the matching value",
      "change": "Case-insensitive matching can coexist with original display case.",
      "added_sql": "SELECT CustomerID, City AS OriginalCity, TRIM(City) AS City,\n       TRIM(LOWER(City)) AS MatchCity\nFROM Customers\nORDER BY CustomerID;",
      "expected_count": 9,
      "sql": "SELECT CustomerID, City AS OriginalCity, TRIM(City) AS City,\n       TRIM(LOWER(City)) AS MatchCity\nFROM Customers\nORDER BY CustomerID;"
    },
    {
      "id": "stage2",
      "title": "Keep eligible cities",
      "change": "Alternate names must still match the intended metros.",
      "added_sql": "select CustomerID,FirstName,LastName,trim(City) as City,State\n-- …\nwhere trim(lower(City)) in (\"bengaluru\",\"mumbai\",\"delhi\",\"hyderabad\",\"chennai\",\"bangalore\",\"bombay\",\"new delhi\")",
      "expected_count": 8,
      "sql": "select CustomerID,FirstName,LastName,trim(City) as City,State\nfrom Customers\nwhere trim(lower(City)) in (\"bengaluru\",\"mumbai\",\"delhi\",\"hyderabad\",\"chennai\",\"bangalore\",\"bombay\",\"new delhi\")\norder by CustomerID;"
    },
    {
      "id": "stage3",
      "title": "Apply the requested ordering",
      "change": "Matching case should not affect alphabetical placement.",
      "added_sql": "order by trim(lower(City)) asc, CustomerID asc",
      "expected_count": 8,
      "final": true
    }
