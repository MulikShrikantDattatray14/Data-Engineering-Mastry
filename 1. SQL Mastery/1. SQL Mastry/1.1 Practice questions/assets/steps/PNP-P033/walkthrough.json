  "steps": [
    {
      "id": "catalogue_products",
      "title": "Why does Products drive the anti-match check?",
      "change": "Start from 🟦 Products because the requested output is a list of catalogue products, including products that have no order history. Starting from 🟩 OrderDetails would lose exactly those never-ordered products before they could be tested.",
      "sql": "SELECT ProductID, Product, Brand, CategoryID, Sale_Price\nFROM Products\nORDER BY ProductID;",
      "added_sql": "FROM Products",
      "inputs": [
        "Products"
      ],
      "expected_count": 2
    },
    {
      "id": "left_joined",
      "title": "Why add OrderDetails with a LEFT JOIN?",
      "change": "🟩 OrderDetails is added after Products because ProductID is already available from the driving catalogue row. The LEFT JOIN on Products.ProductID = OrderDetails.ProductID preserves every product: Pen matches order-detail row 10, while Cup has no match and receives NULL in the green OrderDetails columns. If one product has several order lines, its matched row repeats once per line at this intermediate stage.",
      "sql": "SELECT P.ProductID, P.Product, P.Brand, P.CategoryID, P.Sale_Price,\n       OD.OrderDetailID, OD.OrderID, OD.ProductID AS matched_ProductID\nFROM Products AS P\nLEFT JOIN OrderDetails AS OD\n    ON P.ProductID = OD.ProductID\nORDER BY P.ProductID, OD.OrderDetailID;",
      "added_sql": "LEFT JOIN OrderDetails AS OD\n    ON P.ProductID = OD.ProductID",
      "inputs": [
        "Products",
        "OrderDetails"
      ],
      "expected_count": 2
    },
    {
      "id": "anti_filter_result",
      "title": "Why keep only rows with no order-detail match?",
      "change": "Filter the joined result with OD.OrderDetailID IS NULL. OrderDetailID is the non-null primary key of an actual order-detail row, so NULL identifies a product for which the LEFT JOIN found no order row. Pen is removed because row 10 matched; Cup survives because its right-side key is NULL. A product with multiple matches would have all of its repeated joined rows removed.",
      "sql": "SELECT P.ProductID, P.Product, P.Brand, P.CategoryID, P.Sale_Price\nFROM Products AS P\nLEFT JOIN OrderDetails AS OD\n    ON P.ProductID = OD.ProductID\nWHERE OD.OrderDetailID IS NULL;",
      "added_sql": "WHERE OD.OrderDetailID IS NULL",
      "inputs": [
        "left_joined"
      ],
      "expected_count": 1
    },
    {
      "id": "final",
      "title": "Why sort the retained catalogue products?",
      "change": "The final stage is the exact locked learner query. It returns the five requested Products columns and orders retained products by CategoryID, then ProductID, both ascending.",
      "added_sql": "ORDER BY P.CategoryID ASC, P.ProductID ASC",
      "inputs": [
        "anti_filter_result"
      ],
      "final": true,
      "expected_count": 1
    }
  ],
